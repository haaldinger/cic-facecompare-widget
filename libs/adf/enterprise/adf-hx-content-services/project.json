{
    "name": "adf-enterprise-adf-hx-content-services",
    "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/adf/enterprise/adf-hx-content-services/src",
    "prefix": "hxp",
    "tags": ["scope:adf-enterprise-adf-hx-content-services", "category:adf-enterprise"],
    "projectType": "library",
    "targets": {
        "build": {
            "executor": "@nx/angular:package",
            "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
            "options": {
                "project": "libs/adf/enterprise/adf-hx-content-services/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/tsconfig.lib.json"
                },
                "adf": {
                    "tsConfig": "libs/adf/enterprise/adf-hx-content-services/tsconfig.lib.adf.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "npm-publish": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "options": {
                "commands": [
                    {
                        "command": "npm run mr hxp-lib-packager -- --build 'adf-enterprise-adf-hx-content-services' --publish {args.publish} --tag {args.tag}",
                        "forwardAllArgs": true
                    }
                ],
                "parallel": false
            }
        },
        "test": {
            "options": {
                "passWithNoTests": true
            }
        },
        "prestorybook": {
            "executor": "nx:run-commands",
            "cwd": "./",
            "options": {
                "command": "node scripts/pre-storybook.js"
            }
        },
        "storybook": {
            "dependsOn": ["prestorybook"],
            "executor": "@storybook/angular:start-storybook",
            "options": {
                "port": 4400,
                "configDir": "libs/adf/enterprise/adf-hx-content-services/.storybook",
                "browserTarget": "adf-enterprise-adf-hx-content-services:build-storybook",
                "compodoc": true,
                "compodocArgs": [
                    "-e",
                    "json",
                    "-d",
                    "libs/adf/enterprise/adf-hx-content-services",
                    "--minimal",
                    "--disablePrivate",
                    "--disableInternal",
                    "--disableProtected",
                    "--disableLifeCycleHooks"
                ]
            },
            "configurations": {
                "ci": {
                    "quiet": true
                }
            }
        },
        "build-storybook": {
            "dependsOn": ["prestorybook"],
            "executor": "@storybook/angular:build-storybook",
            "outputs": ["{options.outputDir}"],
            "options": {
                "outputDir": "dist/storybook/adf-enterprise-adf-hx-content-services",
                "configDir": "libs/adf/enterprise/adf-hx-content-services/.storybook",
                "browserTarget": "adf-enterprise-adf-hx-content-services:build-storybook",
                "compodoc": false,
                "styles": [
                    "node_modules/cropperjs/dist/cropper.min.css",
                    "node_modules/pdfjs-dist/web/pdf_viewer.css",
                    "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "node_modules/@hyland/icons/index.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons.css",
                    "apps/workspace-hxp/src/assets/fonts/material-icons/material-icons-outlined.css",
                    "node_modules/@hylandsoftware/satori-fonts/index.css"
                ],
                "stylePreprocessorOptions": {
                    "includePaths": [
                        "libs/shared/core/src/styles",
                        "node_modules/@alfresco/adf-core/lib/styles",
                        "libs/shared-hxp/idp-document-viewer/src/lib/theming",
                        "libs/adf/enterprise/adf-hx-content-services/src/styles",
                        "apps/workspace-hxp/src"
                    ]
                }
            },
            "configurations": {
                "ci": {
                    "quiet": true
                }
            }
        },
        "static-storybook": {
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "adf-enterprise-adf-hx-content-services:build-storybook",
                "staticFilePath": "dist/storybook/adf-enterprise-adf-hx-content-services"
            },
            "configurations": {
                "ci": {
                    "buildTarget": "adf-enterprise-adf-hx-content-services:build-storybook:ci"
                }
            }
        }
    }
}
